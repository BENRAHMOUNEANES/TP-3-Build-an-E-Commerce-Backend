                  "});",
                  "pm.test('Has standard RateLimit headers', function () {",
                  "    pm.expect(pm.response.headers.has('ratelimit-limit') || pm.response.headers.has('RateLimit-Limit')).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
