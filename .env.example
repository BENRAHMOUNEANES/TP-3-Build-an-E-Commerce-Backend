# ==============================================================================
# DzTech Store Backend - Environment Configuration Example
# ENSTA • Module WAMD • TD-TP 3
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Server Port and Environment
PORT=3000
NODE_ENV=development

# MongoDB Connection String (Local Community Server or Atlas)
# Local: mongodb://127.0.0.1:27017/dztech_ecommerce
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/dztech_ecommerce?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/dztech_ecommerce

# Local JWT Configuration
JWT_SECRET=replace_with_a_secure_jwt_secret_key_at_least_32_chars
JWT_EXPIRES_IN=1h

# Client Origin for CORS (e.g., React frontend from TD-TP 2 running on Vite)
CLIENT_ORIGIN=http://localhost:5173

# OAuth 2.0 / OpenID Connect (Default: Google Identity Services)
# Issuer URL for OpenID Connect tokens
OAUTH_ISSUER=https://accounts.google.com

# OAuth Client ID (from Google Cloud Console or Auth0)
OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# OAuth Client Secret (optional for PKCE flows, required for web-server flows)
OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# JWKS URI for provider public key verification (Google default provided)
OAUTH_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs

